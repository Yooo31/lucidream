{
  "name": "lucidream",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e:maestro": "sh -c 'if command -v maestro >/dev/null 2>&1; then maestro test e2e/maestro/flows; elif [ -x \"$HOME/.maestro/bin/maestro\" ]; then \"$HOME/.maestro/bin/maestro\" test e2e/maestro/flows; else echo \"Maestro CLI not found. Install with: curl -Ls \\\"https://get.maestro.mobile.dev\\\" | bash\"; exit 127; fi'",
    "commitlint": "commitlint",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\\n\\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.15.2",
    "@react-navigation/native": "7.1.31",
    "@react-navigation/native-stack": "7.14.2",
    "expo": "^54.0.0",
    "expo-av": "~16.0.8",
    "expo-file-system": "~19.0.21",
    "expo-notifications": "~0.32.16",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.4",
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@semantic-release/npm": "13.1.4",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "19.1.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-preset-expo": "~54.0.8",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-native": "5.0.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "~54.0.16",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "react-test-renderer": "19.1.0",
    "semantic-release": "25.0.3",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=20.19.0 <22",
    "pnpm": ">=9.15.5 <10"
  },
  "packageManager": "pnpm@9.15.5"
}
